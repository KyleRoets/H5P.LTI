# Public HTTPS address of Reach Studio (no trailing slash). Must be reachable by ReachLMS and browsers.
PUBLIC_URL=https://studio.example.com
PORT=3000
# Where the database, signing key and uploaded media are stored. Back this folder up.
DATA_DIR=./data
TOOL_NAME=ReachStudio
# ReachQuizzes (second registration, /lti/register?app=quizzes): its name in ReachLMS, and the
# short label in the course menu. Change the label before installing; ReachLMS stores it then.
QUIZ_TOOL_NAME=ReachQuizzes
QUIZ_NAV_LABEL=Quizzes+
# ReachQuizzes needs a ReachLMS API Developer Key (Admin → Developer Keys → + API Key, redirect URI
# https://<this server>/lti/canvas/callback) to create assignments, set groups, Assign To and publish.
CANVAS_API_CLIENT_ID=
CANVAS_API_CLIENT_SECRET=
# Optional: ReachLMS's address if it differs from what launches report.
CANVAS_API_BASE=
# Comma-separated emails that get the Admin view (or use: npm run make-admin -- someone@school.edu)
ADMIN_EMAILS=
# Optional: require this code on the Dynamic Registration screen so only your admins can install the tool.
REGISTRATION_CODE=
# Set to true when running behind a reverse proxy / load balancer that terminates TLS.
TRUST_PROXY=true
SESSION_HOURS=8
# Largest image, audio or captions file, in MB.
MAX_UPLOAD_MB=50
# Largest video file (MP4/WebM), in MB.
MAX_VIDEO_MB=500
# Optional storage limit per teacher account, in MB (0 = no limit). YouTube/Vimeo links use none.
STORAGE_QUOTA_MB=0
# Local testing only (lets http:// platforms such as the mock ReachLMS register).
ALLOW_INSECURE_PLATFORMS=false
