{
  "name": "reach-studio",
  "version": "1.0.0",
  "description": "Interactive content builder for ReachLMS (Canvas) - LTI 1.3 / LTI Advantage tool",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "add-platform": "node --disable-warning=ExperimentalWarning scripts/add-platform.js",
    "test": "node --disable-warning=ExperimentalWarning test/e2e-lti.test.js",
    "mock-canvas": "node test/mock-canvas.js",
    "demo": "DEMO_MODE=true node --disable-warning=ExperimentalWarning src/server.js",
    "make-admin": "node --disable-warning=ExperimentalWarning scripts/make-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^5.3.0",
    "jose": "^5.10.0",
    "multer": "^2.5.0"
  }
}
